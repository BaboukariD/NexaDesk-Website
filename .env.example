# Local dev: SQLite file.
DATABASE_URL="file:./dev.db"

# On Vercel (production), set DATABASE_URL there instead to the
# Supabase project "arabic-app" (ref crtjwppmmuviofxkepgi), pooled
# connection string, with your database password from the Supabase
# dashboard -> Settings -> Database -> Connection string ->
# "Transaction" mode. It looks like:
#   postgresql://postgres.crtjwppmmuviofxkepgi:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# The schema and seed data (user, 8 topics, error patterns, the
# sentence-builder example) are already applied to that project — see
# prisma/schema.production.prisma, which Vercel's build swaps in
# (vercel-build script / vercel.json buildCommand).

# Generate with: npm run hash-password -- "your password"
# This is a base64-encoded bcrypt hash, not the raw hash — a raw hash's
# "$2a$12$..." pattern gets silently mangled by Next.js's .env variable
# expansion. Never put the plaintext password anywhere, including here.
APP_PASSWORD_HASH=

# Any long random string, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# For OCR of page photographs, ingestion parsing, drill generation,
# and marking free-text answers.
ANTHROPIC_API_KEY=
