// The production variant of schema.prisma, identical except for the
// datasource provider. Prisma's provider must be a literal, not
// env-driven, so local dev (SQLite, prisma/schema.prisma) and
// production (Postgres, here) need two files rather than one that
// branches. `npm run vercel-build` copies this over schema.prisma
// before generating the client and building — see package.json and
// vercel.json.
//
// Keep this in sync with prisma/schema.prisma whenever the data model
// changes: copy the model definitions across, this file's only
// intentional difference is the `datasource` block below.
//
// Note on enums / lists: the SQLite connector used locally supports
// neither native enums nor scalar list fields, so fields that would
// otherwise be an enum or a `String[]` are plain `String` columns
// here too (documented with the allowed values) and JSON-encoded
// where a list is needed, so both schemas stay structurally identical.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core: single user, source material, book structure
// ---------------------------------------------------------------------------

model User {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  // Auth is single-user and env-var based (see src/lib/auth.ts) — the
  // password hash is NOT stored here, to avoid two sources of truth.

  vocabItems           VocabItem[]
  reviewStates         ReviewState[]
  attempts             Attempt[]
  errorPatterns        ErrorPattern[]
  sessions             Session[]
  assessmentAttempts   AssessmentAttempt[]
  translationAttempts  TranslationAttempt[]
  practicePaperResults PracticePaperResult[]
  rootNotes            RootNote[]
  captureItems         CaptureItem[]
  interferencePairs    InterferencePair[]
  lessonNotes          LessonNote[]
  audioRecordings      AudioRecording[]
  stickyWords          StickyWord[]
  backups              Backup[]
}

model Book {
  id      Int     @id @default(autoincrement())
  title   String  @unique
  titleAr String?
  // "upload" | "fetched" | "manual" (the standing home for hand-entered vocab)
  source  String
  fileRef String?

  units Unit[]
}

model Unit {
  id      Int    @id @default(autoincrement())
  bookId  Int
  book    Book   @relation(fields: [bookId], references: [id])
  number  Int
  titleAr String
  titleEn String

  lessons Lesson[]

  @@unique([bookId, number])
}

model Lesson {
  id      Int    @id @default(autoincrement())
  unitId  Int
  unit    Unit   @relation(fields: [unitId], references: [id])
  number  Int
  // "sounds" | "reading" | "writing" | "speaking" | "manual"
  section String

  vocabItems   VocabItem[]
  dialogues    Dialogue[]
  exercises    Exercise[]
  grammarNotes GrammarNote[]
  notes        LessonNote[]

  @@unique([unitId, number])
}

// Single-user app settings. One row, id fixed to "singleton".
model Settings {
  id             String @id @default("singleton")
  newCardsPerDay Int    @default(15)
}

// ---------------------------------------------------------------------------
// Topic spec (5.8) — the 8 exam topics, orthogonal to the book's own
// unit/lesson order. Vocab, exercises, grammar notes and assessment
// content are tagged with a topic so a topic can be drilled in isolation.
// ---------------------------------------------------------------------------

model Topic {
  id     Int    @id @default(autoincrement())
  // slug: introductions | family | housing | food | daily-life | weather | shopping | health
  slug   String @unique
  nameAr String
  nameEn String
  order  Int

  vocabItems          VocabItem[]
  exercises           Exercise[]
  grammarNotes        GrammarNote[]
  assessmentTasks     AssessmentTask[]
  translationTasks    TranslationTask[]
  sentenceBuilderSets SentenceBuilderSet[]
  practicePapers      PracticePaper[]
}

// ---------------------------------------------------------------------------
// Vocabulary, dialogues, exercises, grammar notes
// ---------------------------------------------------------------------------

model VocabItem {
  id       Int    @id @default(autoincrement())
  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id])
  topicId  Int?
  topic    Topic? @relation(fields: [topicId], references: [id])
  userId   Int
  user     User   @relation(fields: [userId], references: [id])

  arabic       String // vowelled
  english      String
  partOfSpeech String?
  root         String? // triliteral root, e.g. "د-ر-س"
  gender       String? // "m" | "f"
  plural       String?
  notes        String?
  // e.g. "Al Qasimia Book 1, unit 3, p.12" — traceable back to source (T)
  sourceRef    String?

  flashcards      Flashcard[]
  interferenceAsA InterferencePair[] @relation("InterferenceA")
  interferenceAsB InterferencePair[] @relation("InterferenceB")
}

model Dialogue {
  id       Int    @id @default(autoincrement())
  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id])
  title    String

  lines DialogueLine[]
}

model DialogueLine {
  id         Int      @id @default(autoincrement())
  dialogueId Int
  dialogue   Dialogue @relation(fields: [dialogueId], references: [id])
  order      Int
  speaker    String
  arabic     String
  english    String

  recordings AudioRecording[]
}

model GrammarNote {
  id       Int     @id @default(autoincrement())
  lessonId Int?
  lesson   Lesson? @relation(fields: [lessonId], references: [id])
  topicId  Int?
  topic    Topic?  @relation(fields: [topicId], references: [id])
  title    String
  bodyAr   String
  bodyEn   String
}

model Exercise {
  id       Int     @id @default(autoincrement())
  lessonId Int
  lesson   Lesson  @relation(fields: [lessonId], references: [id])
  topicId  Int?
  topic    Topic?  @relation(fields: [topicId], references: [id])
  // translate_to_ar | translate_to_en | fill_gap | maa_or_min |
  // possessive_suffix | scrambled_sentence | true_false
  type     String
  // which of the 4 skills this trains, if applicable
  skill    String?
  prompt   String
  answer   String
  options  String? // JSON-encoded string[]

  attempts Attempt[]
}

// ---------------------------------------------------------------------------
// Attempts, spaced repetition, error patterns, sessions
// ---------------------------------------------------------------------------

model Attempt {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  // "exercise" | "flashcard"
  itemType       String
  itemId         Int
  exerciseId     Int?
  exercise       Exercise? @relation(fields: [exerciseId], references: [id])
  // listening | reading | writing | speaking — for the per-skill progress lines
  skill          String?
  userAnswer     String
  // the reference answer this was graded against — lets error-pattern
  // retirement (and later, progress views) query accuracy on a
  // specific word rather than only on this attempt in isolation
  expectedAnswer String?
  correct        Boolean
  responseMs     Int
  createdAt      DateTime  @default(now())
}

// FSRS scheduler state, one row per flashcard. Field names follow the
// ts-fsrs Card shape directly so state round-trips without translation.
model ReviewState {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  flashcardId   Int
  flashcard     Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  due           DateTime
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  scheduledDays Float     @default(0)
  learningSteps Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  // New | Learning | Review | Relearning
  state         String    @default("New")
  lastReview    DateTime?

  @@unique([userId, flashcardId])
}

model Flashcard {
  id         Int       @id @default(autoincrement())
  vocabId    Int
  vocabItem  VocabItem @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  // front is always vowelled Arabic; a sentence is preferred over the bare word
  sentenceAr String?
  sentenceEn String?
  createdAt  DateTime  @default(now())

  reviewStates ReviewState[]
}

model ErrorPattern {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  // stable programmatic key, e.g. "maadha_vs_ayna" — the description is
  // free text for display, this is what detectors and seeding key off
  key          String
  description  String
  // listening | reading | writing | speaking — so 5.8's per-skill
  // weaknesses lists can filter rather than showing one merged list
  skill        String?
  exampleItems String // JSON-encoded string[]
  frequency    Int      @default(0)
  lastSeen     DateTime @default(now())
  // set once accuracy exceeds ~90% across 10 spaced attempts
  retired      Boolean  @default(false)
  // one-line "why was this wrong" cached by error type (M) — an API
  // call happens once per pattern ever, not once per wrong answer
  explanation  String?

  @@unique([userId, key])
}

model Session {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  itemsAttempted Int       @default(0)
  accuracy       Float?
}

// ---------------------------------------------------------------------------
// 5.8 Mark-scheme mode — assessment layer on top of daily practice.
// Not built in step 1; schema is here now so later work doesn't need
// a disruptive migration.
// ---------------------------------------------------------------------------

model AssessmentTask {
  id              Int      @id @default(autoincrement())
  topicId         Int
  topic           Topic    @relation(fields: [topicId], references: [id])
  // writing | speaking_roleplay | speaking_photocard | speaking_conversation
  type            String
  prompt          String
  wordCountTarget Int?
  imageRef        String?
  rolePlayPrompts String? // JSON-encoded string[], 5 short exchanges
  createdAt       DateTime @default(now())

  attempts       AssessmentAttempt[]
  practicePapers PracticePaper[]
}

model AssessmentAttempt {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  taskId        Int
  task          AssessmentTask @relation(fields: [taskId], references: [id])
  responseText  String
  contentScore  Int // 0-5
  accuracyScore Int // 0-5
  rangeScore    Int // 0-5
  feedback      String // Claude's reasoning per criterion
  modelAnswer   String
  createdAt     DateTime       @default(now())
}

model TranslationTask {
  id        Int      @id @default(autoincrement())
  topicId   Int
  topic     Topic    @relation(fields: [topicId], references: [id])
  // en_to_ar | ar_to_en
  direction String
  createdAt DateTime @default(now())

  items          TranslationItem[]
  practicePapers PracticePaper[]
}

model TranslationItem {
  id                Int             @id @default(autoincrement())
  translationTaskId Int
  translationTask   TranslationTask @relation(fields: [translationTaskId], references: [id])
  order             Int
  sourceText        String
  targetText        String

  attempts TranslationAttempt[]
}

model TranslationAttempt {
  id                Int             @id @default(autoincrement())
  userId            Int
  user              User            @relation(fields: [userId], references: [id])
  translationItemId Int
  translationItem   TranslationItem @relation(fields: [translationItemId], references: [id])
  userAnswer        String
  score             Int // partial credit, e.g. 0-2
  feedback          String?
  createdAt         DateTime        @default(now())
}

model SentenceBuilderSet {
  id      Int    @id @default(autoincrement())
  topicId Int
  topic   Topic  @relation(fields: [topicId], references: [id])
  titleAr String

  columns SentenceBuilderColumn[]

  @@unique([topicId, titleAr])
}

model SentenceBuilderColumn {
  id    Int                @id @default(autoincrement())
  setId Int
  set   SentenceBuilderSet @relation(fields: [setId], references: [id])
  order Int
  label String // e.g. subject | verb | object | time

  options SentenceBuilderOption[]
}

model SentenceBuilderOption {
  id       Int                   @id @default(autoincrement())
  columnId Int
  column   SentenceBuilderColumn @relation(fields: [columnId], references: [id])
  arabic   String // vowelled
  gloss    String
}

// A practice paper is a snapshot taken at generation time, not a live
// pointer into mutable content — listening/reading passages are
// stored directly rather than referencing a Dialogue that might
// change later. writingTaskId/translationTaskId reuse the existing
// assessment and translation infrastructure rather than duplicating
// it.
model PracticePaper {
  id                    Int              @id @default(autoincrement())
  topicId               Int
  topic                 Topic            @relation(fields: [topicId], references: [id])
  listeningTranscriptAr String
  listeningTranscriptEn String
  listeningQuestions    String // JSON: {question, answer}[]
  readingPassageAr      String
  readingPassageEn      String
  readingQuestions      String // JSON: {question, answer}[]
  writingTaskId         Int?
  writingTask           AssessmentTask?  @relation(fields: [writingTaskId], references: [id])
  translationTaskId     Int?
  translationTask       TranslationTask? @relation(fields: [translationTaskId], references: [id])
  createdAt             DateTime         @default(now())

  results PracticePaperResult[]
}

model PracticePaperResult {
  id                   Int           @id @default(autoincrement())
  paperId              Int
  paper                PracticePaper @relation(fields: [paperId], references: [id])
  userId               Int
  user                 User          @relation(fields: [userId], references: [id])
  listeningScorePct    Float
  readingScorePct      Float
  writingContentScore  Int
  writingAccuracyScore Int
  writingRangeScore    Int
  translationScorePct  Float
  overallPct           Float
  durationSeconds      Int
  createdAt            DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Root explorer (5.5)
// ---------------------------------------------------------------------------

// A Quran cross-reference for one root, always suggested-then-confirmed
// by Djibril (see src/lib/roots.ts) — never auto-populated. Getting a
// Quranic citation wrong for a hafiz is a real failure, not a cosmetic
// one, so this is only ever saved after he's seen and accepted it.
model RootNote {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  root         String
  quranRef     String? // e.g. "٢:٣٢"
  quranSnippet String? // a few words only, never a full ayah
  updatedAt    DateTime @updatedAt

  @@unique([userId, root])
}

// ---------------------------------------------------------------------------
// Quick capture inbox — one field, Arabic in, processed later (F)
// ---------------------------------------------------------------------------

model CaptureItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  arabic    String
  gloss     String? // filled in by auto-glossing when processed
  // pending | processed | discarded
  status    String   @default("pending")
  vocabId   Int? // set once turned into a real VocabItem
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Interference pairs (K) — two words that keep getting swapped for
// each other. wordAId is always < wordBId so a pair has one row
// regardless of which direction the confusion runs.
// ---------------------------------------------------------------------------

model InterferencePair {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  wordAId   Int
  wordA     VocabItem @relation("InterferenceA", fields: [wordAId], references: [id])
  wordBId   Int
  wordB     VocabItem @relation("InterferenceB", fields: [wordBId], references: [id])
  swapCount Int       @default(1)
  lastSeen  DateTime  @default(now())

  @@unique([userId, wordAId, wordBId])
}

// ---------------------------------------------------------------------------
// Per-lesson notes for Class mode (H)
// ---------------------------------------------------------------------------

model LessonNote {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  body      String
  updatedAt DateTime @updatedAt

  @@unique([lessonId, userId])
}

// ---------------------------------------------------------------------------
// Self-comparison audio (P) — his recording next to the reference,
// never scored or transcribed.
// ---------------------------------------------------------------------------

model AudioRecording {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  dialogueLineId Int
  dialogueLine   DialogueLine @relation(fields: [dialogueLineId], references: [id])
  audioData      String // base64-encoded
  mimeType       String
  createdAt      DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Sticky words list (I) — separate from the pattern-based Weaknesses
// view. Explicit tracked state rather than a purely derived query,
// because the exit rule ("three correct across three separate days,
// not three in one sitting") needs day-boundary bookkeeping that's
// awkward to recompute from Attempt history alone every time.
// ---------------------------------------------------------------------------

model StickyWord {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id])
  arabic           String
  gloss            String?
  timesSeen        Int       @default(0)
  timesWrong       Int       @default(0)
  // JSON string[], most recent last, capped at 3
  lastWrongAnswers String    @default("[]")
  // JSON { reading: {seen,wrong}, listening: {seen,wrong}, production: {seen,wrong} }
  skillBreakdown   String    @default("{\"reading\":{\"seen\":0,\"wrong\":0},\"listening\":{\"seen\":0,\"wrong\":0},\"production\":{\"seen\":0,\"wrong\":0}}")
  // dates (YYYY-MM-DD) on which a correct answer was given, most
  // recent last — three distinct entries clears the word
  correctDays      String    @default("[]")
  active           Boolean   @default(true)
  enteredAt        DateTime  @default(now())
  graduatedAt      DateTime?

  @@unique([userId, arabic])
}

// ---------------------------------------------------------------------------
// Backups (G) — "everything he types is learning data he cannot
// recreate." A weekly automatic dump plus on-demand export, stored as
// a row rather than a file since there's no persistent local disk on
// a serverless deploy.
// ---------------------------------------------------------------------------

model Backup {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  // "manual" | "weekly"
  trigger   String
  data      String // JSON dump, see src/lib/export.ts
  createdAt DateTime @default(now())
}
